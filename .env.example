# API address used by browser requests.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# API address used by Next.js server-side requests.
INTERNAL_API_URL=http://localhost:5000/api/v1

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-nextauth-secret

# Public URL of the built widget script (pulsedesk-widget dist/widget.js).
# Shown in the install snippet on Dashboard -> Widget & Site.
NEXT_PUBLIC_WIDGET_URL=https://pulsedesk-widget.vercel.app/widget.js
